SESSION_SECRET=replace-with-a-long-random-string

# SSLCommerz payment gateway. Get sandbox keys at https://developer.sslcommerz.com/registration/
# Leave the store ID empty to use the built-in test gateway (development only).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "false" for live payments; anything else uses the sandbox.
SSLCOMMERZ_SANDBOX=true
# Public address of this site, used for SSLCommerz's return and IPN URLs, e.g. https://app.example.com
APP_URL=
# Production builds only: allow the test gateway when no SSLCommerz keys are set. Never on a live site.
# PAYMENTS_TEST_GATEWAY=true
