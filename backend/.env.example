# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=true
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. Leave empty to use SQLite (backend/db.sqlite3).
# Supabase: Project → Connect. Locally use the "Session pooler" string (port 5432); on Vercel use the
# "Transaction pooler" string (port 6543). Add ?sslmode=require on the end of either.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Signs login tokens. Must be the same value as JWT_SIGNING_KEY in frontend/.env.local.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=

# Public address of the Next.js app (SSLCommerz returns owners there).
FRONTEND_URL=http://localhost:3000

# The platform's SSLCommerz account (collects subscriptions).
# SSLCommerz payment gateway (sandbox keys: https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# true for sandbox keys. Defaults to DJANGO_DEBUG, so a live site uses the real gateway unless told otherwise.
SSLCOMMERZ_SANDBOX=true
# Production only: allow the test gateway when no SSLCommerz keys are set. Never on a live site.
# PAYMENTS_TEST_GATEWAY=true

# Production (Vercel) only:
# Secret that Vercel Cron sends to /api/cron/cleanup/ (daily: expired logins, and businesses whose approved deletion is due). Any long random string.
# CRON_SECRET=
# Seconds to keep a database connection open. Leave 0 with Supabase's transaction pooler and with runserver.
# DATABASE_CONN_MAX_AGE=0

# Email: sends ADMIN_EMAILS the full error whenever the live site breaks.
# Any SMTP account works, e.g. Gmail (smtp.gmail.com, with an App Password), Zoho or Brevo.
# Without EMAIL_HOST, emails are printed in the server's console instead (fine for development).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Friday Inventory <you@gmail.com>
# ADMIN_EMAILS=you@gmail.com
