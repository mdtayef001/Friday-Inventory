# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=true
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Signs login tokens. Must be the same value as JWT_SIGNING_KEY in frontend/.env.local.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=

# Public address of the Next.js app (SSLCommerz returns owners there).
FRONTEND_URL=http://localhost:3000

# Encrypts secrets kept in the database (each business's own SSLCommerz password).
# Optional: derived from DJANGO_SECRET_KEY when empty. Changing it means owners re-enter their passwords.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# The platform's SSLCommerz account (collects subscriptions). Businesses add their own in Business Settings.
# SSLCommerz payment gateway (sandbox keys: https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Production only: allow the test gateway when no SSLCommerz keys are set. Never on a live site.
# PAYMENTS_TEST_GATEWAY=true
